+// Copyright 2026 Google LLC
+// SPDX-License-Identifier: Apache-2.0
+
+//! Strict private-anonymous snapshot restore. No shared/vhost-user fallback.
+
+use std::fs::File;
+use std::io;
+use std::os::fd::AsRawFd;
+
+use vm_memory::{Address, GuestAddress, GuestMemory, GuestMemoryRegion};
+use vm_migration::protocol::MemoryRangeTable;
+
+use crate::GuestMemoryMmap;
+
+pub(crate) const CAPABILITY: &str = "restore-cow-strict-v1";
+
+// Caller must hold exclusive ownership of the newly allocated memory before
+// registering memslots or handing pointers to device threads. Published source
+// inodes must never be truncated or overwritten during the mapping's lifetime.
+pub(crate) fn restore(
+    memory: &GuestMemoryMmap,
+    source: &File,
+    ranges: &MemoryRangeTable,
+) -> io::Result<()> {
+    // SAFETY: _SC_PAGESIZE takes no pointers and returns the host page size.
+    let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) };
+    if page <= 0 {
+        return Err(io::Error::other("Invalid host page size"));
+    }
+    let page = page as u64;
+    let source_len = source.metadata()?.len();
+    let mut offset: u64 = 0;
+    let mut windows = Vec::new();
+    let mut seen = Vec::new();
+    // Validate the entire plan before modifying any guest mapping.
+    for range in ranges.regions() {
+        let invalid =
+            || io::Error::new(io::ErrorKind::InvalidInput, "Unsupported CoW memory range");
+        let end = range.gpa.checked_add(range.length).ok_or_else(invalid)?;
+        let file_end = offset.checked_add(range.length).ok_or_else(invalid)?;
+        if range.length == 0
+            || range.gpa % page != 0
+            || range.length % page != 0
+            || offset % page != 0
+            || file_end > source_len
+            || file_end > i64::MAX as u64
+            || range.length > usize::MAX as u64
+        {
+            return Err(invalid());
+        }
+        let region = memory
+            .find_region(GuestAddress(range.gpa))
+            .ok_or_else(invalid)?;
+        let flags = region.flags();
+        if region.file_offset().is_some()
+            || flags & libc::MAP_PRIVATE == 0
+            || flags & libc::MAP_ANONYMOUS == 0
+            || flags & (libc::MAP_SHARED | libc::MAP_HUGETLB) != 0
+            || end
+                > region
+                    .start_addr()
+                    .raw_value()
+                    .checked_add(region.len())
+                    .ok_or_else(invalid)?
+            || seen
+                .iter()
+                .any(|&(start, stop)| range.gpa < stop && end > start)
+        {
+            return Err(invalid());
+        }
+        let address = memory
+            .get_host_address(GuestAddress(range.gpa))
+            .map_err(|_| invalid())?;
+        windows.push((
+            address,
+            range.length as usize,
+            offset as libc::off_t,
+            flags & libc::MAP_NORESERVE,
+        ));
+        seen.push((range.gpa, end));
+        offset = file_end;
+    }
+    // This strict subset has no external or unplugged RAM. Containment and
+    // nonoverlap above, plus equal lengths, prove complete guest RAM coverage.
+    let ram_len = memory.iter().try_fold(0u64, |total, region| {
+        total.checked_add(region.len()).ok_or_else(|| {
+            io::Error::new(io::ErrorKind::InvalidInput, "CoW guest RAM length overflow")
+        })
+    })?;
+    if offset == 0 || offset != ram_len || offset != source_len {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "CoW snapshot must exactly cover all guest RAM and source bytes",
+        ));
+    }
+    for (address, length, offset, reserve) in windows {
+        // SAFETY: every window was checked page-aligned, nonoverlapping and
+        // wholly within exclusively owned anonymous RAM. MAP_FIXED replaces
+        // only that window. The read-only fd is live and cannot map past EOF.
+        let mapped = unsafe {
+            libc::mmap(
+                address.cast(),
+                length,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_FIXED | reserve,
+                source.as_raw_fd(),
+                offset,
+            )
+        };
+        if mapped == libc::MAP_FAILED {
+            // The caller aborts and drops this memory manager on any error.
+            return Err(io::Error::last_os_error());
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use std::fs;
+    use std::io::{Read, Seek, SeekFrom, Write};
+
+    use vm_memory::{Bytes, FileOffset, MmapRegion};
+    use vm_migration::protocol::MemoryRange;
+
+    use super::*;
+    use crate::GuestRegionMmap;
+    use crate::vm_config::VmConfig;
+
+    fn page() -> u64 {
+        // SAFETY: _SC_PAGESIZE reads a scalar system property with no pointers.
+        unsafe { libc::sysconf(libc::_SC_PAGESIZE) as u64 }
+    }
+    fn table(start: u64, length: u64) -> MemoryRangeTable {
+        let mut t = MemoryRangeTable::default();
+        t.push(MemoryRange { gpa: start, length });
+        t
+    }
+    fn image() -> File {
+        let mut f = tempfile::tempfile().unwrap();
+        f.write_all(&vec![0x31; page() as usize]).unwrap();
+        f.set_len(2 * page()).unwrap();
+        f
+    }
+    fn guest() -> GuestMemoryMmap {
+        GuestMemoryMmap::from_ranges(&[(GuestAddress(0), (2 * page()) as usize)]).unwrap()
+    }
+    // Mirrors MemoryManager::send's dense volatile-copy branch. The mmap
+    // metadata intentionally remains private anonymous so checkpoints use it.
+    fn checkpoint(g: &GuestMemoryMmap) -> File {
+        let mut f = tempfile::tempfile().unwrap();
+        let mut n = 0;
+        while n < 2 * page() {
+            n += g
+                .write_volatile_to(GuestAddress(n), &mut f, (2 * page() - n) as usize)
+                .unwrap() as u64;
+        }
+        f
+    }
+    #[test]
+    fn cow_api_selection_is_explicit_and_prefault_is_rejected() {
+        use crate::config::{MemoryRestoreMode, RestoreConfig};
+        let default = RestoreConfig::parse("source_url=/tmp/snapshot").unwrap();
+        assert_eq!(default.memory_restore_mode, MemoryRestoreMode::Copy);
+        let cow = RestoreConfig::parse("source_url=/tmp/snapshot,memory_restore_mode=copyonwrite")
+            .unwrap();
+        assert_eq!(cow.memory_restore_mode, MemoryRestoreMode::CopyOnWrite);
+        let parsed: RestoreConfig = serde_json::from_str(
+            r#"{"source_url":"/tmp/snapshot","memory_restore_mode":"CopyOnWrite"}"#,
+        )
+        .unwrap();
+        assert_eq!(parsed.memory_restore_mode, MemoryRestoreMode::CopyOnWrite);
+        let prefault = RestoreConfig {
+            prefault: true,
+            ..cow
+        };
+        assert!(
+            prefault
+                .validate(&serde_json::from_str::<VmConfig>("{}").unwrap())
+                .is_err()
+        );
+    }
+    #[test]
+    fn cow_clones_and_recheckpoint_preserve_private_dirty_pages() {
+        let mut source = image();
+        let t = table(0, 2 * page());
+        let a = guest();
+        let b = guest();
+        restore(&a, &source, &t).unwrap();
+        restore(&b, &source, &t).unwrap();
+        assert_eq!(a.read_obj::<u8>(GuestAddress(0)).unwrap(), 0x31);
+        assert_eq!(b.read_obj::<u8>(GuestAddress(page())).unwrap(), 0);
+        a.write_obj::<u8>(0xa1, GuestAddress(0)).unwrap();
+        b.write_obj::<u8>(0xb2, GuestAddress(page())).unwrap();
+        assert_eq!(b.read_obj::<u8>(GuestAddress(0)).unwrap(), 0x31);
+        assert_eq!(a.read_obj::<u8>(GuestAddress(page())).unwrap(), 0);
+        source.seek(SeekFrom::Start(0)).unwrap();
+        let mut byte = [0];
+        source.read_exact(&mut byte).unwrap();
+        assert_eq!(byte[0], 0x31);
+        for (vm, first, second) in [(&a, 0xa1, 0), (&b, 0x31, 0xb2)] {
+            let mut next = checkpoint(vm);
+            for _ in 0..3 {
+                let restored = guest();
+                restore(&restored, &next, &t).unwrap();
+                assert_eq!(restored.read_obj::<u8>(GuestAddress(0)).unwrap(), first);
+                assert_eq!(
+                    restored.read_obj::<u8>(GuestAddress(page())).unwrap(),
+                    second
+                );
+                next = checkpoint(&restored);
+            }
+        }
+    }
+    #[test]
+    fn cow_rejects_invalid_ranges_before_any_mapping() {
+        let g = guest();
+        let f = image();
+        for t in [
+            table(1, page()),
+            table(0, 3 * page()),
+            table(0, 0),
+            table(u64::MAX - 1, page()),
+        ] {
+            assert!(restore(&g, &f, &t).is_err());
+        }
+        let mut t = table(0, page());
+        t.push(MemoryRange {
+            gpa: 0,
+            length: page(),
+        });
+        assert!(restore(&g, &f, &t).is_err());
+        assert_eq!(g.read_obj::<u8>(GuestAddress(0)).unwrap(), 0);
+        let short = tempfile::tempfile().unwrap();
+        short.set_len(page()).unwrap();
+        assert!(restore(&g, &short, &table(0, 2 * page())).is_err());
+    }
+    #[test]
+    fn cow_rejects_shared_and_private_file_backed_memory() {
+        for flags in [libc::MAP_SHARED, libc::MAP_PRIVATE] {
+            let f = image();
+            let region = MmapRegion::build(
+                Some(FileOffset::new(f, 0)),
+                (2 * page()) as usize,
+                libc::PROT_READ | libc::PROT_WRITE,
+                flags,
+            )
+            .unwrap();
+            let g = GuestMemoryMmap::from_regions(vec![
+                GuestRegionMmap::new(region, GuestAddress(0)).unwrap(),
+            ])
+            .unwrap();
+            assert!(restore(&g, &image(), &table(0, 2 * page())).is_err());
+        }
+    }
+    #[test]
+    fn cow_mapping_survives_source_unlink_and_descriptor_close() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("memory-ranges");
+        fs::write(&path, vec![0x5a; (2 * page()) as usize]).unwrap();
+        let file = File::open(&path).unwrap();
+        let g = guest();
+        restore(&g, &file, &table(0, 2 * page())).unwrap();
+        fs::remove_file(path).unwrap();
+        drop(file);
+        assert_eq!(g.read_obj::<u8>(GuestAddress(page())).unwrap(), 0x5a);
+    }
+    #[test]
+    fn cow_rejects_empty_range_table() {
+        let g = guest();
+        assert!(restore(&g, &image(), &MemoryRangeTable::default()).is_err());
+    }
+    #[test]
+    fn cow_rejects_partial_ram_coverage_before_mapping() {
+        let g = guest();
+        g.write_obj::<u8>(0x7c, GuestAddress(0)).unwrap();
+        let source = tempfile::tempfile().unwrap();
+        source.set_len(page()).unwrap();
+        assert!(restore(&g, &source, &table(0, page())).is_err());
+        assert_eq!(g.read_obj::<u8>(GuestAddress(0)).unwrap(), 0x7c);
+    }
+    #[test]
+    fn cow_rejects_trailing_source_bytes_before_mapping() {
+        let g = guest();
+        let source = image();
+        source.set_len(3 * page()).unwrap();
+        g.write_obj::<u8>(0x7c, GuestAddress(0)).unwrap();
+        assert!(restore(&g, &source, &table(0, 2 * page())).is_err());
+        assert_eq!(g.read_obj::<u8>(GuestAddress(0)).unwrap(), 0x7c);
+    }
+    #[test]
+    fn cow_accepts_complete_discontiguous_ram() {
+        let g = GuestMemoryMmap::from_ranges(&[
+            (GuestAddress(0), page() as usize),
+            (GuestAddress(3 * page()), page() as usize),
+        ])
+        .unwrap();
+        let mut ranges = table(0, page());
+        ranges.push(MemoryRange {
+            gpa: 3 * page(),
+            length: page(),
+        });
+        restore(&g, &image(), &ranges).unwrap();
+        assert_eq!(g.read_obj::<u8>(GuestAddress(0)).unwrap(), 0x31);
+        assert_eq!(g.read_obj::<u8>(GuestAddress(3 * page())).unwrap(), 0);
+    }
+}
