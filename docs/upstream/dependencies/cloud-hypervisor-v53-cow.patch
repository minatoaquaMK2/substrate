+#[cfg(all(test, feature = "kvm", target_arch = "x86_64"))]
+mod cow_preflight_tests {
+    use std::panic::{AssertUnwindSafe, catch_unwind};
+    use std::sync::atomic::{AtomicBool, Ordering};
+
+    use hypervisor::arch::x86::CpuIdEntry;
+
+    use super::*;
+
+    struct PreflightHypervisor(Arc<AtomicBool>);
+    impl hypervisor::Hypervisor for PreflightHypervisor {
+        fn hypervisor_type(&self) -> hypervisor::HypervisorType {
+            hypervisor::HypervisorType::Kvm
+        }
+        fn create_vm(
+            &self,
+            _: HypervisorVmConfig,
+        ) -> result::Result<Arc<dyn hypervisor::Vm>, hypervisor::HypervisorError> {
+            self.0.store(true, Ordering::SeqCst);
+            Err(hypervisor::HypervisorError::VmCreate(anyhow!(
+                "Preflight reached VM creation"
+            )))
+        }
+        fn get_supported_cpuid(
+            &self,
+        ) -> result::Result<Vec<CpuIdEntry>, hypervisor::HypervisorError> {
+            unreachable!("VM creation stops this test")
+        }
+        fn get_max_vcpus(&self) -> u32 {
+            1
+        }
+    }
+
+    fn construct(
+        mode: MemoryRestoreMode,
+        snapshot: Option<&Snapshot>,
+        reached: Arc<AtomicBool>,
+    ) -> Result<Vm> {
+        let event = || EventFd::new(libc::EFD_NONBLOCK).unwrap();
+        Vm::new(
+            Arc::new(Mutex::new(serde_json::from_str("{}").unwrap())),
+            event(),
+            event(),
+            event(),
+            #[cfg(feature = "guest_debug")]
+            event(),
+            &SeccompAction::Allow,
+            Arc::new(PreflightHypervisor(reached)),
+            event(),
+            None,
+            None,
+            Arc::new(Mutex::new(None)),
+            snapshot,
+            Some("/unused-snapshot"),
+            Some(false),
+            Some(mode),
+        )
+    }
+
+    #[test]
+    fn cow_rejects_missing_memory_snapshot_before_vm_creation() {
+        let root = Snapshot::default();
+        for snapshot in [None, Some(&root)] {
+            let reached = Arc::new(AtomicBool::new(false));
+            let result = catch_unwind(AssertUnwindSafe(|| {
+                construct(MemoryRestoreMode::CopyOnWrite, snapshot, reached.clone())
+            }));
+            assert!(
+                !reached.load(Ordering::SeqCst),
+                "Strict CoW reached VM creation without saved memory"
+            );
+            assert!(matches!(
+                result,
+                Ok(Err(Error::MemoryManager(MemoryManagerError::SnapshotCoW(
+                    _
+                ))))
+            ));
+        }
+    }
+
+    #[test]
+    fn cow_preflight_preserves_legacy_and_present_memory_paths() {
+        let empty = Snapshot::default();
+        let mut present = Snapshot::default();
+        present.add_snapshot(MEMORY_MANAGER_SNAPSHOT_ID.to_owned(), Snapshot::default());
+        for (mode, snapshot) in [
+            (MemoryRestoreMode::Copy, None),
+            (MemoryRestoreMode::OnDemand, Some(&empty)),
+            (MemoryRestoreMode::CopyOnWrite, Some(&present)),
+        ] {
+            let reached = Arc::new(AtomicBool::new(false));
+            let result = catch_unwind(AssertUnwindSafe(|| {
+                construct(mode, snapshot, reached.clone())
+            }));
+            // Existing create_hypervisor_vm unwraps the sentinel error.
+            assert!(result.is_err());
+            assert!(reached.load(Ordering::SeqCst));
+        }
+    }
+}
